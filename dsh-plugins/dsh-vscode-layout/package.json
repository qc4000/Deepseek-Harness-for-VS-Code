{
  "name": "dsh-vscode-layout",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：把 DSH Web 页面左侧栏的实时宽度与折叠状态上报给外层宿主（只读测量，不改页面、不拦事件），供 Deepseek-Harness-for-VS-Code 扩展做视口裁剪。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "vscode",
    "webview",
    "layout",
    "sidebar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
