{
  "name": "dsh-vscode-workspace",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：面板被 VS Code 扩展内嵌时，把 DSH 当前工作区切到宿主当前文件夹（调用 DSH 公开客户端服务，不改页面 DOM），由 Deepseek-Harness-for-VS-Code 扩展内置分发。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "vscode",
    "webview",
    "workspace"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
