{
  "name": "deepseek-harness-vscode",
  "displayName": "DeepSeek Harness for VSCode",
  "description": "%ext.description%",
  "version": "1.1.3",
  "publisher": "vithrive",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vithrive/Deepseek-Harness-for-VS-Code.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:all": "node scripts/run-tests.js --e2e",
    "test:one": "node scripts/run-tests.js --only",
    "test:verbose": "node scripts/run-tests.js --verbose",
    "package": "node scripts/package.js release",
    "package:debug": "node scripts/package.js debug",
    "package:rc": "node scripts/package.js rc",
    "package:release": "node scripts/package.js release"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:dsh.webview",
    "onCommand:dshPanel.resetChatMapping",
    "onCommand:dshPanel.chatStatus",
    "onStartupFinished"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "dsh",
        "displayName": "DeepSeek Harness"
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness Panel",
      "properties": {
        "dshPanel.locale": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "zh", "en"],
          "enumDescriptions": [
            "%cfg.dshPanel.locale.enum.auto%",
            "%cfg.dshPanel.locale.enum.zh%",
            "%cfg.dshPanel.locale.enum.en%"
          ],
          "description": "%cfg.dshPanel.locale.desc%"
        },
        "dshPanel.url": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "%cfg.dshPanel.url.desc%"
        },
        "dshPanel.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "%cfg.dshPanel.host.desc%"
        },
        "dshPanel.port": {
          "type": "number",
          "default": 3080,
          "description": "%cfg.dshPanel.port.desc%"
        },
        "dshPanel.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.autoStart.desc%"
        },
        "dshPanel.autoRegisterWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.autoRegisterWorkspace.desc%"
        },
        "dshPanel.pinWorkspaceToVSCode": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.pinWorkspaceToVSCode.desc%"
        },
        "dshPanel.openSystemBrowser": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.dshPanel.openSystemBrowser.desc%"
        },
        "dshPanel.installClipboardPlugin": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.installClipboardPlugin.desc%"
        },
        "dshPanel.installOpenExternalPlugin": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.installOpenExternalPlugin.desc%"
        },
        "dshPanel.externalLinkAction": {
          "type": "string",
          "default": "systemBrowser",
          "enum": [
            "off",
            "systemBrowser",
            "vscodeBrowser"
          ],
          "enumDescriptions": [
            "%cfg.dshPanel.externalLinkAction.enum.off%",
            "%cfg.dshPanel.externalLinkAction.enum.systemBrowser%",
            "%cfg.dshPanel.externalLinkAction.enum.vscodeBrowser%"
          ],
          "markdownDescription": "%cfg.dshPanel.externalLinkAction.mdesc%"
        },
        "dshPanel.forwardVSCodeKeys": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.forwardVSCodeKeys.desc%"
        },
        "dshPanel.forwardKeybindings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "markdownDescription": "%cfg.dshPanel.forwardKeybindings.mdesc%"
        },
        "dshPanel.focusReleaseKey": {
          "type": "string",
          "default": "F6",
          "markdownDescription": "%cfg.dshPanel.focusReleaseKey.mdesc%"
        },
        "dshPanel.focusInputEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.dshPanel.focusInputEnabled.mdesc%"
        },
        "dshPanel.workspaceFileLinkAction": {
          "type": "string",
          "default": "revealAndOpen",
          "enum": [
            "revealAndOpen",
            "diffAndOpen",
            "revealOnly",
            "off"
          ],
          "enumDescriptions": [
            "%cfg.dshPanel.workspaceFileLinkAction.enum.revealAndOpen%",
            "%cfg.dshPanel.workspaceFileLinkAction.enum.diffAndOpen%",
            "%cfg.dshPanel.workspaceFileLinkAction.enum.revealOnly%",
            "%cfg.dshPanel.workspaceFileLinkAction.enum.off%"
          ],
          "description": "%cfg.dshPanel.workspaceFileLinkAction.desc%"
        },
        "dshPanel.outOfWorkspaceFileAccess": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.dshPanel.outOfWorkspaceFileAccess.mdesc%"
        },
        "dshPanel.dshSidebar": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "show",
            "hide"
          ],
          "enumDescriptions": [
            "%cfg.dshPanel.dshSidebar.enum.auto%",
            "%cfg.dshPanel.dshSidebar.enum.show%",
            "%cfg.dshPanel.dshSidebar.enum.hide%"
          ],
          "description": "%cfg.dshPanel.dshSidebar.desc%"
        },
        "dshPanel.debugLogToFile": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.dshPanel.debugLogToFile.desc%"
        },
        "dshPanel.autoInstallDsh": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.autoInstallDsh.desc%"
        },
        "dshPanel.dshCommand": {
          "type": "string",
          "default": "dsh",
          "description": "%cfg.dshPanel.dshCommand.desc%"
        },
        "dshPanel.remoteAuthProxy": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.remoteAuthProxy.desc%"
        },
        "dshPanel.killOnDispose": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.killOnDispose.desc%"
        },
        "dshPanel.chatAgentPreset": {
          "type": "string",
          "default": "",
          "description": "%cfg.dshPanel.chatAgentPreset.desc%"
        },
        "dshPanel.chatProvider": {
          "type": "string",
          "default": "",
          "description": "%cfg.dshPanel.chatProvider.desc%"
        },
        "dshPanel.chatModel": {
          "type": "string",
          "default": "",
          "description": "%cfg.dshPanel.chatModel.desc%"
        },
        "dshPanel.chatTimeoutMs": {
          "type": "number",
          "default": 900000,
          "description": "%cfg.dshPanel.chatTimeoutMs.desc%"
        },
        "dshPanel.chatSyncLookbackMin": {
          "type": "number",
          "default": 60,
          "description": "%cfg.dshPanel.chatSyncLookbackMin.desc%"
        },
        "dshPanel.enableDshModel": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.enableDshModel.desc%"
        },
        "dshPanel.debugModelMessages": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.dshPanel.debugModelMessages.desc%"
        },
        "dshPanel.markForeignAssistant": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.dshPanel.markForeignAssistant.desc%"
        },
        "dshPanel.dshReasoningEffort": {
          "type": "string",
          "default": "",
          "enum": ["", "off", "low", "high", "max"],
          "description": "%cfg.dshPanel.dshReasoningEffort.desc%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-panel",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-panel": [
        {
          "type": "webview",
          "id": "dsh.webview",
          "name": "DeepSeek Harness"
        }
      ]
    },
    "commands": [
      {
        "command": "dshPanel.openInTab",
        "title": "%cmd.dshPanel.openInTab.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "dshPanel.openInBrowser",
        "title": "%cmd.dshPanel.openInBrowser.title%",
        "icon": "$(globe)"
      },
      {
        "command": "dshPanel.refresh",
        "title": "%cmd.dshPanel.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "dshPanel.restart",
        "title": "%cmd.dshPanel.restart.title%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dsh.sendSelection",
        "title": "%cmd.dsh.sendSelection.title%"
      },
      {
        "command": "dshPanel.resetChatMapping",
        "title": "%cmd.dshPanel.resetChatMapping.title%"
      },
      {
        "command": "dshPanel.chatStatus",
        "title": "%cmd.dshPanel.chatStatus.title%"
      },
      {
        "command": "dshPanel.keyStatus",
        "title": "%cmd.dshPanel.keyStatus.title%"
      },
      {
        "command": "dshPanel.focusInput",
        "title": "%cmd.dshPanel.focusInput.title%"
      },
      {
        "command": "dshPanel.toggleDshSidebar",
        "title": "%cmd.dshPanel.toggleDshSidebar.title%"
      },
      {
        "command": "dshPanel.diagnoseModels",
        "title": "%cmd.dshPanel.diagnoseModels.title%"
      },
      {
        "command": "dshPanel.diagnoseSidebar",
        "title": "%cmd.dshPanel.diagnoseSidebar.title%"
      },
      {
        "command": "dshPanel.openDebugLog",
        "title": "%cmd.dshPanel.openDebugLog.title%"
      }
    ],
    "keybindings": [
      {
        "command": "dshPanel.focusInput",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "dshPanelFocusInput"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.sendSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@100"
        }
      ],
      "view/title": [
        {
          "command": "dshPanel.refresh",
          "when": "view == dsh.webview",
          "group": "navigation"
        },
        {
          "command": "dshPanel.restart",
          "when": "view == dsh.webview",
          "group": "navigation"
        },
        {
          "command": "dshPanel.openInTab",
          "when": "view == dsh.webview",
          "group": "navigation"
        },
        {
          "command": "dshPanel.openInBrowser",
          "when": "view == dsh.webview",
          "group": "navigation"
        }
      ]
    }
  }
}
